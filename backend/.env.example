# DataInsight Backend - Environment Configuration
# Copy this file to .env and modify as needed

# Application
APP_NAME=DataInsight
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ENVIRONMENT=development

# Database (MySQL for production, SQLite for local dev)
# For local development without MySQL, use:
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# For MySQL production:
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/datainsight

# Redis (optional for MVP - set to empty to disable)
REDIS_URL=

# JWT
JWT_SECRET_KEY=dev-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
